{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "APL US Stock Cover Image Brief",
  "description": "Structured input for APL Blog Cover / SEO two-step workflow: ImageGen cinematic background first, local text overlay second.",
  "type": "object",
  "required": [
    "version",
    "scanDate",
    "marketConclusion",
    "capitalFlow",
    "riskBackground",
    "leadershipDestination",
    "mainVisualMetaphor",
    "sceneConcept",
    "nativeCompositions",
    "composition",
    "imageGenerationBrief",
    "overlay"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "APL Cover Brief v1.1"
    },
    "scanDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "marketConclusion": {
      "type": "string",
      "description": "One clear sentence describing what the market is doing in this issue."
    },
    "capitalFlow": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" }
      }
    },
    "riskBackground": {
      "type": "string"
    },
    "leadershipDestination": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "mainVisualMetaphor": {
      "type": "string",
      "description": "Single concrete cinematic scene. Not a dashboard, not an infographic."
    },
    "sceneConcept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "coreMarketThesis", "subjectIdentity", "primarySceneElements", "colorPalette", "lightingDirection", "cinematicMood", "brandAtmosphere", "artStyle"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "coreMarketThesis": { "type": "string", "minLength": 1 },
        "subjectIdentity": { "type": "string", "minLength": 1 },
        "primarySceneElements": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "colorPalette": { "type": "string", "minLength": 1 },
        "lightingDirection": { "type": "string", "minLength": 1 },
        "cinematicMood": { "type": "string", "minLength": 1 },
        "brandAtmosphere": { "type": "string", "minLength": 1 },
        "artStyle": { "type": "string", "minLength": 1 }
      }
    },
    "nativeCompositions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cover", "seo"],
      "properties": {
        "cover": { "$ref": "#/$defs/coverNativeComposition" },
        "seo": { "$ref": "#/$defs/seoNativeComposition" }
      }
    },
    "composition": {
      "type": "object",
      "required": ["textSafeArea", "storyArea", "rules"],
      "properties": {
        "textSafeArea": { "type": "string" },
        "storyArea": { "type": "string" },
        "rules": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "imageGenerationBrief": {
      "type": "object",
      "required": ["sharedPrompt", "coverPrompt", "seoPrompt", "negativePrompt"],
      "properties": {
        "sharedPrompt": { "type": "string", "minLength": 1 },
        "coverPrompt": { "type": "string", "minLength": 1 },
        "seoPrompt": { "type": "string", "minLength": 1 },
        "negativePrompt": { "type": "string" },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "overlay": {
      "type": "object",
      "required": ["titleLines", "subtitle"],
      "additionalProperties": false,
      "properties": {
        "titleLines": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "maxItems": 4
        },
        "subtitle": {
          "type": "string",
          "minLength": 8,
          "description": "Issue-specific description of the main title. Must not repeat the renderer-owned APL DEEP-SCAN kicker, brand or series identity, scan date, or a title line; semantic enforcement is performed by validate_managed_inputs.ps1."
        },
        "footer": { "type": "string" },
        "accentWords": {
          "type": "array",
          "items": { "type": "string" }
        },
        "cover": { "$ref": "#/$defs/overlayVariantConfig" },
        "seo": { "$ref": "#/$defs/overlayVariantConfig" }
      }
    }
  },
  "$defs": {
    "nativeCompositionBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspect_ratio", "camera_distance", "framing_description", "subject_placement", "text_safe_area"],
      "properties": {
        "aspect_ratio": { "type": "string" },
        "camera_distance": { "type": "string", "minLength": 1 },
        "framing_description": { "type": "string", "minLength": 1 },
        "subject_placement": { "type": "string", "minLength": 1 },
        "text_safe_area": { "type": "string", "minLength": 1 }
      }
    },
    "coverNativeComposition": {
      "allOf": [
        { "$ref": "#/$defs/nativeCompositionBase" },
        { "properties": { "aspect_ratio": { "const": "4:5" } } }
      ]
    },
    "seoNativeComposition": {
      "allOf": [
        { "$ref": "#/$defs/nativeCompositionBase" },
        { "properties": { "aspect_ratio": { "const": "16:9" } } }
      ]
    },
    "overlayVariantConfig": {
      "type": "object",
      "description": "Optional local overlay layout controls for a specific output variant. Missing values fall back to renderer defaults.",
      "properties": {
        "margin": { "type": "number" },
        "top": { "type": "number" },
        "logoWidth": { "type": "number" },
        "logoHeight": { "type": "number" },
        "logoGap": { "type": "number" },
        "kickerOffsetY": { "type": "number" },
        "kickerHeight": { "type": "number" },
        "titleY": { "type": "number" },
        "titleLineHeight": { "type": "number" },
        "subtitleGap": { "type": "number" },
        "subtitleHeight": { "type": "number" },
        "metaGap": { "type": "number" },
        "metaHeight": { "type": "number" },
        "footerY": { "type": "number" },
        "footerHeight": { "type": "number" },
        "textSafeHeightRatio": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 0.8
        },
        "fontKicker": { "type": "number" },
        "fontTitle": { "type": "number" },
        "fontSubtitle": { "type": "number" },
        "fontMeta": { "type": "number" },
        "fontFooter": { "type": "number" },
        "trackingKicker": { "type": "number" },
        "trackingTitle": { "type": "number" },
        "trackingSubtitle": { "type": "number" },
        "trackingMeta": { "type": "number" },
        "trackingFooter": { "type": "number" }
      },
      "additionalProperties": false
    }
  }
}
