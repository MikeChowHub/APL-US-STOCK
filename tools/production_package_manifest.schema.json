{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "APL Production Package Manifest",
  "type": "object",
  "required": ["SchemaVersion", "ScanDate", "Status", "PackageRoot", "RequiredCount", "FileCount", "TotalBytes", "GeneratedUtc", "Required", "Files"],
  "additionalProperties": false,
  "properties": {
    "SchemaVersion": { "type": "string", "const": "APL Production Package Manifest v1.0" },
    "ScanDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "Status": { "type": "string", "const": "PASS" },
    "PackageRoot": { "type": "string", "const": "production-package" },
    "RequiredCount": { "type": "integer", "minimum": 12 },
    "FileCount": { "type": "integer", "minimum": 12 },
    "TotalBytes": { "type": "integer", "minimum": 1 },
    "GeneratedUtc": { "type": "string", "minLength": 1 },
    "Required": {
      "type": "array",
      "minItems": 12,
      "items": { "$ref": "#/$defs/requiredRecord" }
    },
    "Files": {
      "type": "array",
      "minItems": 12,
      "items": { "$ref": "#/$defs/fileRecord" }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "fileRecord": {
      "type": "object",
      "required": ["RelativePath", "Size", "SHA256"],
      "additionalProperties": false,
      "properties": {
        "RelativePath": { "$ref": "#/$defs/relativePath" },
        "Size": { "type": "integer", "minimum": 1 },
        "SHA256": { "$ref": "#/$defs/sha256" }
      }
    },
    "requiredRecord": {
      "type": "object",
      "required": ["Id", "RelativePath", "Size", "SHA256"],
      "additionalProperties": false,
      "properties": {
        "Id": { "type": "string", "minLength": 1 },
        "RelativePath": { "$ref": "#/$defs/relativePath" },
        "Size": { "type": "integer", "minimum": 1 },
        "SHA256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
