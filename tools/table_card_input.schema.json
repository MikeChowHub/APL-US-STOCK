{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "APL US Stock Table Card Input",
  "description": "Semantic, card-type-specific input contract. Renderer-owned headers map named row fields to display columns.",
  "type": "object",
  "required": ["SchemaVersion", "CardType", "Title", "Rows"],
  "additionalProperties": false,
  "properties": {
    "SchemaVersion": { "type": "string", "const": "APL Table Card Input v1.1" },
    "CardType": {
      "type": "string",
      "enum": ["ExecutiveSummary", "TopLeaders", "TopGainers", "SectorStructure", "MarketObservation", "Comparison"]
    },
    "Title": { "type": "string", "minLength": 1 },
    "Subtitle": { "type": "string" },
    "Rows": { "type": "array", "minItems": 1, "maxItems": 8 },
    "SourceNote": { "type": "string" },
    "FooterNote": { "type": "string" },
    "Meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "Source": { "type": "string" },
        "MarketTheme": { "type": "string" },
        "ProductionNote": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "CardType": { "const": "ExecutiveSummary" } }, "required": ["CardType"] },
      "then": { "properties": { "Rows": { "items": { "$ref": "#/$defs/executiveSummaryRow" } } } }
    },
    {
      "if": { "properties": { "CardType": { "const": "TopLeaders" } }, "required": ["CardType"] },
      "then": { "properties": { "Rows": { "items": { "$ref": "#/$defs/topLeaderRow" } } } }
    },
    {
      "if": { "properties": { "CardType": { "const": "TopGainers" } }, "required": ["CardType"] },
      "then": {
        "properties": {
          "Title": { "const": "Top Gainers — Past 7 Days" },
          "Rows": { "items": { "$ref": "#/$defs/topGainerRow" } }
        }
      }
    },
    {
      "if": { "properties": { "CardType": { "const": "SectorStructure" } }, "required": ["CardType"] },
      "then": { "properties": { "Rows": { "items": { "$ref": "#/$defs/sectorStructureRow" } } } }
    },
    {
      "if": { "properties": { "CardType": { "const": "MarketObservation" } }, "required": ["CardType"] },
      "then": { "properties": { "Rows": { "items": { "$ref": "#/$defs/marketObservationRow" } } } }
    },
    {
      "if": { "properties": { "CardType": { "const": "Comparison" } }, "required": ["CardType"] },
      "then": { "properties": { "Rows": { "items": { "$ref": "#/$defs/comparisonRow" } } } }
    }
  ],
  "$defs": {
    "nonBlank": { "type": "string", "pattern": ".*\\S.*" },
    "symbol": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9.-]*$" },
    "executiveSummaryRow": {
      "type": "object",
      "required": ["observation", "meaning"],
      "additionalProperties": false,
      "properties": { "observation": { "type": "string", "minLength": 1, "pattern": "[\\u3400-\\u9FFF]" }, "meaning": { "type": "string", "minLength": 1, "pattern": "[\\u3400-\\u9FFF]" } }
    },
    "topLeaderRow": {
      "type": "object",
      "required": ["rank", "symbol", "companyName", "coreBusiness", "mainDriver", "compositeScore"],
      "additionalProperties": false,
      "properties": {
        "rank": { "type": "string", "pattern": "^#[1-9][0-9]*$" },
        "symbol": { "$ref": "#/$defs/symbol" },
        "companyName": { "$ref": "#/$defs/nonBlank" },
        "coreBusiness": { "$ref": "#/$defs/nonBlank" },
        "mainDriver": { "$ref": "#/$defs/nonBlank" },
        "compositeScore": { "type": "number" }
      }
    },
    "topGainerRow": {
      "type": "object",
      "required": ["symbol", "companyName", "sectorTheme", "changePct"],
      "additionalProperties": false,
      "properties": {
        "symbol": { "$ref": "#/$defs/symbol" },
        "companyName": { "$ref": "#/$defs/nonBlank" },
        "sectorTheme": { "$ref": "#/$defs/nonBlank" },
        "changePct": { "type": "string", "pattern": "^[+-]\\d+(?:\\.\\d{1,2})?%$" }
      }
    },
    "sectorStructureRow": {
      "type": "object",
      "required": ["theme", "count", "direction", "representativeSymbols"],
      "additionalProperties": false,
      "properties": {
        "theme": { "$ref": "#/$defs/nonBlank" },
        "count": { "type": "integer", "minimum": 1 },
        "direction": { "type": "string", "minLength": 1, "pattern": "[\\u3400-\\u9FFF]" },
        "representativeSymbols": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9.-]*(?:,\\s*[A-Z0-9][A-Z0-9.-]*)*$" }
      }
    },
    "marketObservationRow": {
      "type": "object",
      "required": ["observation", "meaning", "evidence"],
      "additionalProperties": false,
      "properties": {
        "observation": { "$ref": "#/$defs/nonBlank" },
        "meaning": { "$ref": "#/$defs/nonBlank" },
        "evidence": { "$ref": "#/$defs/nonBlank" }
      }
    },
    "comparisonRow": {
      "type": "object",
      "required": ["signal", "whatItShows", "marketMeaning"],
      "additionalProperties": false,
      "properties": {
        "signal": { "$ref": "#/$defs/nonBlank" },
        "whatItShows": { "$ref": "#/$defs/nonBlank" },
        "marketMeaning": { "$ref": "#/$defs/nonBlank" }
      }
    }
  }
}
