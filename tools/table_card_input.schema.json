{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "APL US Stock Table Card Input",
  "description": "Structured input contract for rendering one APL Blog Table Card at a time. Table Cards are research information cards, not CSV screenshots.",
  "type": "object",
  "required": ["SchemaVersion", "Title", "Rows"],
  "additionalProperties": false,
  "properties": {
    "SchemaVersion": {
      "type": "string",
      "const": "APL Table Card Input v1.0"
    },
    "CardType": {
      "type": "string",
      "enum": [
        "ExecutiveSummary",
        "TopLeaders",
        "TopGainers",
        "SectorStructure",
        "MarketObservation",
        "Comparison"
      ],
      "description": "Optional self-declared card type. If present, it must match the renderer -CardType parameter."
    },
    "Title": {
      "type": "string",
      "minLength": 1,
      "description": "Client-facing card title."
    },
    "Subtitle": {
      "type": "string",
      "description": "Optional short context line below the title."
    },
    "Columns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["Label", "Width"],
        "additionalProperties": false,
        "properties": {
          "Label": {
            "type": "string",
            "minLength": 1
          },
          "Width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "Align": {
            "type": "string",
            "enum": ["Near", "Center", "Far"]
          },
          "Bold": {
            "type": "boolean"
          }
        }
      },
      "description": "Optional column definition. If omitted, the renderer uses the default columns for the selected CardType."
    },
    "Rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 5,
        "items": {
          "type": ["string", "number", "integer", "boolean", "null"]
        }
      },
      "description": "Structured rows. Keep rows short enough to be readable at 1600x900."
    },
    "SourceNote": {
      "type": "string",
      "description": "Optional source note. TopGainers cards default to TradingView source note when omitted."
    },
    "FooterNote": {
      "type": "string",
      "description": "Optional footer note."
    },
    "Meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "Source": {
          "type": "string"
        },
        "MarketTheme": {
          "type": "string"
        },
        "ProductionNote": {
          "type": "string"
        }
      }
    }
  }
}
