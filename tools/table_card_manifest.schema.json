{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "APL Table Card Manifest",
  "type": "object",
  "required": ["SchemaVersion", "ScanDate", "Cards"],
  "additionalProperties": false,
  "properties": {
    "SchemaVersion": {
      "type": "string",
      "const": "APL Table Card Manifest v1.1"
    },
    "ScanDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "Cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["CardType", "InputSchemaVersion", "InputPath", "OutputName", "Required"],
        "additionalProperties": false,
        "properties": {
          "CardType": {
            "type": "string",
            "enum": ["ExecutiveSummary", "TopLeaders", "TopGainers", "SectorStructure", "MarketObservation", "Comparison"]
          },
          "InputSchemaVersion": {
            "type": "string",
            "const": "APL Table Card Input v1.1"
          },
          "InputPath": {
            "type": "string",
            "minLength": 1
          },
          "OutputName": {
            "type": "string",
            "pattern": "^[^\\\\/:*?\"<>]+\\.png$"
          },
          "Required": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
