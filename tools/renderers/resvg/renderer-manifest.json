      "fontFallbackWarningCount": 0,
      "invalidGeometryWarningCount": 0,
      "actionOnWarning": "fail-and-delete-partial-output"
    },
    "requiredSmokeTests": ["minimal-svg", "representative-dashboard-svg"],
    "requiredPngValidation": ["new-file", "non-zero-bytes", "png-magic", "exact-dimensions", "system-drawing-load"]
  }
