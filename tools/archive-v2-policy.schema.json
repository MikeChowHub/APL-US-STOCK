{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "APL Archive V2 Adoption Policy v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["SchemaVersion", "MarkerId", "AdoptionDate", "LegacyUnverifiedDates"],
  "properties": {
    "SchemaVersion": { "const": "APL Archive V2 Adoption Policy v1.0" },
    "MarkerId": { "type": "string", "minLength": 1 },
    "AdoptionDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "LegacyUnverifiedDates": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
    },
    "Notes": { "type": "string" }
  }
}
