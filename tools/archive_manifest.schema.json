{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "APL Daily Archive Manifest v2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["SchemaVersion", "ScanDate", "Status", "Source", "Destination", "CopyMode", "FinalProductionAudit", "SourceFileCount", "ArchiveFileCount", "TotalBytes", "VerifiedUtc", "Files"],
  "properties": {
    "SchemaVersion": { "const": "APL Daily Archive Manifest v2.0" },
    "ScanDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "Status": { "enum": ["PENDING_INDEX", "PASS"] },
    "Source": { "type": "string", "minLength": 1 },
    "Destination": { "type": "string", "minLength": 1 },
    "CopyMode": { "const": "COPY_SOURCE_UNCHANGED" },
    "FinalProductionAudit": { "type": "string", "minLength": 1 },
    "SourceFileCount": { "type": "integer", "minimum": 1 },
    "ArchiveFileCount": { "type": "integer", "minimum": 1 },
    "TotalBytes": { "type": "integer", "minimum": 1 },
    "VerifiedUtc": { "type": "string", "minLength": 1 },
    "Files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["RelativePath", "Size", "SHA256"],
        "properties": {
          "RelativePath": { "type": "string", "minLength": 1 },
          "Size": { "type": "integer", "minimum": 0 },
          "SHA256": { "type": "string", "pattern": "^[0-9A-F]{64}$" }
        }
      }
    }
  }
}
